# CalendarBot ADK Agent — Environment Variables
# Copy these from the parent project .env or fill in your values.

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token

# Google Gemini / AI Studio API Key (for development)
# Leave blank to use Vertex AI (set GOOGLE_GENAI_USE_VERTEXAI=True instead)
GOOGLE_API_KEY=your_gemini_api_key

# Google OAuth 2.0 credentials (from GCP Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Fernet encryption key for storing OAuth tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_key

# Public base URL of this service (used for OAuth redirect URI and Telegram webhook)
# For local dev, use ngrok or similar tunneling tool: https://ngrok.com/
BASE_URL=https://your-cloud-run-url.a.run.app

# SQLite database path
DATABASE_URL=sqlite:///./data/calendar_bot.db

# Redis URL (for OAuth state and aiogram FSM storage)
REDIS_URL=redis://localhost:6379/0

# Webhook secret (leave blank to auto-generate at startup)
# WEBHOOK_SECRET=

# ADK / Vertex AI settings (for production)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-east1
# GOOGLE_GENAI_USE_VERTEXAI=True
